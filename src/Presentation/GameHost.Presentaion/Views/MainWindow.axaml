<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameHost.Presentation.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GameHost.Presentation.Views"
        xmlns:gameRender="clr-namespace:GameHost.Presentaion.GameRender"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GameHost.Presentaion.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="GameHost.Presentation">

	<gameRender:GameSurface x:Name="gameSurface" />

</Window>
